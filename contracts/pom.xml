<?xml version="1.0" encoding="UTF-8"?>
<!-- Required XML/Maven boilerplate. -->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>com.cagritasoz</groupId>
		<artifactId>home-energy-tracker</artifactId>
		<version>0.0.1-SNAPSHOT</version>
		<relativePath>../pom.xml</relativePath> <!-- The parent POM is one directory above me -->
	</parent>

	<!-- This identifies this particular Maven module as "contracts" -->
	<artifactId>contracts</artifactId>

	<packaging>jar</packaging> <!-- When Maven builds this module, the output should be a JAR -->

	<name>contracts</name>

	<description>
		Shared event envelope, DTOs, topic constants and JSON examples for Kafka contracts.
		Plain jar, no Spring dependency - producers/consumers depend on this instead of each other's packages.
	</description>

	<dependencies>

		<!-- Compile-time only (optional = not passed on to modules that depend on contracts), for @Builder on
		     the event records like every other DTO in this project. Nothing else: this jar stays dependency-free. -->
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<optional>true</optional>
		</dependency>

	</dependencies>

	<!--
	    The shared vocabulary of the user/device events on Kafka (decided 2026-09-26, reversing the earlier
	    "each side keeps its own copy" approach for these events): the event envelope, the per-event data
	    records, event-type names, topic and header names. Plain classes only - no Spring, no JPA, no
	    logic beyond field validation. Services depend on it with a normal <dependency> on this artifact.
	-->

	<!-- No <build> section needed: spring-boot-maven-plugin is only in spring-boot-starter-parent's
	     pluginManagement (config for IF it's bound), never in its actual <plugins> - and pluginManagement
	     alone never activates a plugin. Nothing here declares it, and it isn't one of the handful of
	     plugins (compiler, jar, surefire, ...) Maven's default lifecycle binds automatically for jar
	     packaging, so it never runs against this module. Verified via `mvn help:effective-pom -pl
	     contracts`: repackaging goal is absent from the effective build either way. -->

</project>
